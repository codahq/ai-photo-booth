{
  "name": "ai-photo-booth",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  // Let VS Code compute workspaceMount itself - it handles Windows path
  // translation, and a hand-written source=c:\... mount string is a footgun.
  // workspaceFolder is stated explicitly to match the mount VS Code creates,
  // so the folder it opens can't drift from the folder that exists.
  "workspaceFolder": "/workspaces/ai-photo-booth",

  // node_modules live in named volumes rather than in the bind-mounted source.
  // A bind mount would put them back on the Windows filesystem, which is both
  // slow and how we ended up with Linux binaries sitting in the working tree.
  "mounts": [
    "source=apb-backend-node-modules,target=/workspaces/${localWorkspaceFolderBasename}/backend/node_modules,type=volume",
    "source=apb-frontend-node-modules,target=/workspaces/${localWorkspaceFolderBasename}/frontend/node_modules,type=volume"
  ],

  // Lets `docker compose up` work from a terminal inside the container by
  // talking to the host's Docker daemon, rather than nesting a second one.
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      // The typescript-node:22 base is Debian trixie, which has no moby-cli
      // packages. Without this the feature install fails the image build.
      // false installs the upstream Docker CE CLI instead.
      "moby": false
    }
  },

  // Fresh named volumes are owned by root; hand them to the container user
  // before installing.
  "postCreateCommand": "sudo chown node:node backend/node_modules frontend/node_modules && npm ci --prefix backend && npm ci --prefix frontend",

  "forwardPorts": [3001, 5174],
  "portsAttributes": {
    "3001": { "label": "backend" },
    "5174": { "label": "frontend" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // TypeScript 7 dropped the legacy tsserver.js in favour of an LSP server
        // built into the native binary. This extension is what speaks to it, and
        // replaces VS Code's built-in JS/TS IntelliSense. Without it the editor
        // falls back to its own bundled TypeScript, which is a different version
        // from the one that builds this project.
        "TypeScriptTeam.native-preview",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker"
      ],
      "settings": {
        // Don't set typescript.tsdk: there is no tsserver.js to point it at.
        // The native-preview extension locates the platform binary itself.
        "editor.formatOnSave": false,
        "files.eol": "\n"
      }
    }
  },

  "remoteUser": "node"
}
