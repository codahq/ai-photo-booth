# Copy this file to .env and fill in your values
OPENAI_API_KEY=your-openai-api-key-here
VITE_API_URL=http://localhost:3001

# Optional. Which OpenAI image model the backend falls back to when a request
# doesn't name one. The picker in the UI overrides this per photo.
# OPENAI_IMAGE_MODEL=gpt-image-2

# Optional. Which origin the backend accepts browser requests from. Compose sets
# this to the published frontend port; the code default is the Vite dev port.
# FRONTEND_ORIGIN=http://localhost:5174

# Optional. Where the backend writes photos INSIDE the container. Compose mounts
# PHOTO_STORAGE at /app/storage, which is where the code looks by default, so
# this only needs setting when running the backend outside a container.
# STORAGE_DIR=/app/storage

# Where photos are stored on the host. Keep this OUTSIDE C:\Users - Windows
# updates have wiped the profile directory before, and Docker named volumes
# are worse still (a Docker Desktop reset destroys them).
PHOTO_STORAGE=C:/photobooth
