# Copy this file to .env and fill in your values
OPENAI_API_KEY=your-openai-api-key-here
VITE_API_URL=http://localhost:3001

# Where photos are stored on the host. Keep this OUTSIDE C:\Users - Windows
# updates have wiped the profile directory before, and Docker named volumes
# are worse still (a Docker Desktop reset destroys them).
PHOTO_STORAGE=C:/photobooth
